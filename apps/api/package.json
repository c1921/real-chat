{
  "name": "@real-chat/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API for Real Chat",
  "main": "dist/app.js",
  "scripts": {
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,API\" -c \"yellow.bold,cyan.bold\" \"pnpm run watch\" \"pnpm run dev:server\"",
    "dev:server": "fastify start --ignore-watch=.ts$ --watch -l info -P dist/app.js",
    "watch": "tsc --watch",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "start": "fastify start -l info dist/app.js",
    "test": "tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/sensible": "^6.0.4",
    "fastify": "^5.11.2",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "c8": "^11.0.0",
    "concurrently": "^9.2.1",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
