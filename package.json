{
  "name": "real-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Vue and Fastify monorepo for Real Chat",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @real-chat/web dev",
    "dev:api": "pnpm --filter @real-chat/api dev",
    "build": "pnpm --recursive --filter ./apps/* build",
    "build:web": "pnpm --filter @real-chat/web build",
    "build:api": "pnpm --filter @real-chat/api build",
    "type-check": "pnpm --recursive --if-present type-check",
    "test": "pnpm --recursive --if-present test",
    "format": "pnpm --recursive --if-present format"
  },
  "license": "UNLICENSED"
}
